{
  "name": "@saring/sdk",
  "version": "0.1.1",
  "private": false,
  "description": "Conflict-blind jury for prediction-market disputes: Solana + Arcium MPC client, venue verdict reader, Panta adapter",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p . --noEmit",
    "example:dispute": "ts-node --transpile-only -P tsconfig.json examples/full-dispute.ts",
    "example:panta": "ts-node --transpile-only -P tsconfig.json examples/panta-adapter.ts"
  },
  "dependencies": {
    "@noble/curves": "^1.4.2",
    "@noble/hashes": "^1.4.0"
  },
  "peerDependencies": {
    "@anchor-lang/core": "^1.0.2",
    "@arcium-hq/client": "0.15.0",
    "@solana/web3.js": "^1.98.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PugarHuda/saring.git",
    "directory": "sdk"
  }
}
